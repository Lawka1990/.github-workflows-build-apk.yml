+          
+              private void fillLastKnownLocation() {
+                  try {
+                      LocationManager lm = (LocationManager) getSystemService(Context.LOCATION_SERVICE);
+                      if (lm == null) {
+                          Toast.makeText(this, "Usługa lokalizacji jest niedostępna", Toast.LENGTH_LONG).show();
+                          return;
+                      }
+                      Location best = null;
+                      List<String> providers = lm.getProviders(true);
+                      for (String provider : providers) {
+                          Location loc = lm.getLastKnownLocation(provider);
+                          if (loc != null && (best == null || loc.getAccuracy() < best.getAccuracy())) best = loc;
+                      }
+                      if (best != null) {
+                          applyLocation(best, "Pobrano ostatnią pozycję GPS");
+                          return;
+                      }
+                      requestFreshLocation(lm);
+                  } catch (SecurityException e) {
+                      Toast.makeText(this, "Brak uprawnienia lokalizacji", Toast.LENGTH_LONG).show();
+                  }
+              }
+          
+              private void requestFreshLocation(LocationManager lm) {
+                  try {
+                      String provider = null;
+                      if (lm.isProviderEnabled(LocationManager.GPS_PROVIDER)) provider = LocationManager.GPS_PROVIDER;
+                      else if (lm.isProviderEnabled(LocationManager.NETWORK_PROVIDER)) provider = LocationManager.NETWORK_PROVIDER;
+                      if (provider == null) {
+                          Toast.makeText(this, "Włącz lokalizację/GPS w telefonie i spróbuj ponownie", Toast.LENGTH_LONG).show();
+                          return;
+                      }
+                      Handler handler = new Handler(Looper.getMainLooper());
+                      final Runnable[] timeout = new Runnable[1];
+                      LocationListener listener = new LocationListener() {
+                          @Override
+                          public void onLocationChanged(Location location) {
+                              try { lm.removeUpdates(this); } catch (Exception ignored) {}
+                              if (timeout[0] != null) handler.removeCallbacks(timeout[0]);
+                              applyLocation(location, "Pobrano aktualną pozycję GPS");
+                          }
+                      };
+                      timeout[0] = () -> {
+                          try { lm.removeUpdates(listener); } catch (Exception ignored) {}
+                          Toast.makeText(this, "Nie udało się uzyskać aktualnej pozycji. Spróbuj na zewnątrz lub wpisz współrzędne ręcznie.", Toast.LENGTH_LONG).show();
+                      };
+                      Toast.makeText(this, "Pobieram aktualną lokalizację…", Toast.LENGTH_SHORT).show();
+                      lm.requestLocationUpdates(provider, 0, 0, listener, Looper.getMainLooper());
+                      handler.postDelayed(timeout[0], 15000);
+                  } catch (SecurityException e) {
+                      Toast.makeText(this, "Brak uprawnienia lokalizacji", Toast.LENGTH_LONG).show();
+                  } catch (Exception e) {
+                      Toast.makeText(this, "Nie udało się uruchomić GPS: " + e.getMessage(), Toast.LENGTH_LONG).show();
+                  }
+              }
