+              private void addStepper(LinearLayout root) {
+                  LinearLayout wrap = new LinearLayout(this);
+                  wrap.setOrientation(LinearLayout.VERTICAL);
+                  wrap.setPadding(0, 0, 0, dp(12));
+                  root.addView(wrap, matchWrap());
+          
+                  LinearLayout row = new LinearLayout(this);
+                  row.setOrientation(LinearLayout.HORIZONTAL);
+                  row.setGravity(Gravity.CENTER);
+                  wrap.addView(row, matchWrap());
+          
+                  String[] labels = {"Dane", "Lokalizacja", "Zdjęcia", "Wysyłka"};
+                  for (int i = 0; i < labels.length; i++) {
+                      LinearLayout item = new LinearLayout(this);
+                      item.setOrientation(LinearLayout.VERTICAL);
+                      item.setGravity(Gravity.CENTER);
+                      row.addView(item, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1));
+          
+                      TextView dot = new TextView(this);
+                      boolean done = (step == 1 && i == 0) || (step >= 2 && i < 3) || (step == 3 && i < 4);
+                      boolean active = (step == 0 && i == 0) || (step == 1 && (i == 1 || i == 2)) || ((step == 2 || step == 3) && i == 3);
+                      dot.setText(done ? "✓" : String.valueOf(i + 1));
+                      dot.setTextSize(14);
+                      dot.setTypeface(Typeface.DEFAULT_BOLD);
+                      dot.setTextColor(Color.WHITE);
+                      dot.setGravity(Gravity.CENTER);
+                      dot.setBackground(round(done ? GREEN : active ? BLUE : Color.rgb(170, 174, 166), 999));
+                      item.addView(dot, new LinearLayout.LayoutParams(dp(30), dp(30)));
+          
+                      TextView label = new TextView(this);
+                      label.setText(labels[i]);
+                      label.setTextSize(12);
+                      label.setTextColor(active || done ? TEXT : MUTED);
+                      label.setGravity(Gravity.CENTER);
+                      label.setPadding(0, dp(5), 0, 0);
+                      item.addView(label);
+                  }
+              }
