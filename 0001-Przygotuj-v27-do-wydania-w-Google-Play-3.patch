+          
+              private double[] parseCoords() {
+                  if (coordinatesValue == null) return null;
+                  try {
+                      ArrayList<Double> nums = new ArrayList<>();
+                      Matcher matcher = Pattern.compile("[-+]?\\d+(?:[\\.,]\\d+)?").matcher(coordinatesValue.trim());
+                      while (matcher.find()) nums.add(Double.parseDouble(matcher.group().replace(",", ".")));
+                      if (nums.size() < 2) return null;
+                      double lat = nums.get(0);
+                      double lon = nums.get(1);
+                      if (lat < -90 || lat > 90 || lon < -180 || lon > 180) return null;
+                      return new double[]{lat, lon};
+                  } catch (Exception e) {
+                      return null;
+                  }
+              }
+          
+              private String osmEmbedUrl() {
+                  double[] ll = parseCoords();
+                  if (ll == null) {
+                      return "https://www.openstreetmap.org/export/embed.html?bbox=14.0%2C49.0%2C24.5%2C55.2&layer=mapnik";
+                  }
+                  double lat = ll[0];
+                  double lon = ll[1];
+                  double d = 0.01;
+                  return String.format(Locale.US,
+                          "https://www.openstreetmap.org/export/embed.html?bbox=%.6f%%2C%.6f%%2C%.6f%%2C%.6f&layer=mapnik&marker=%.6f%%2C%.6f",
+                          lon - d, lat - d, lon + d, lat + d, lat, lon);
+              }
