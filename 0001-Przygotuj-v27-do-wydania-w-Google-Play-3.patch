+              private void writeZip(ZipOutputStream zip, String name, String text) throws IOException {
+                  writeZipBytes(zip, name, text.getBytes(StandardCharsets.UTF_8));
+              }
+          
+              private void writeZipBytes(ZipOutputStream zip, String name, byte[] bytes) throws IOException {
+                  zip.putNextEntry(new ZipEntry(name));
+                  zip.write(bytes);
+                  zip.closeEntry();
+              }
