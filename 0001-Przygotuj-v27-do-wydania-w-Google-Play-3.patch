+              private class PdfReportWriter {
+                  private static final int W = 595;
+                  private static final int H = 842;
+                  private static final int M = 28;
+                  private final PdfDocument document;
+                  private PdfDocument.Page page;
+                  private Canvas canvas;
+                  private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+                  private int y;
+                  private int pageNo = 0;
+          
+                  PdfReportWriter(PdfDocument document) { this.document = document; }
+          
+                  void startPage() {
+                      if (page != null) document.finishPage(page);
+                      pageNo++;
+                      page = document.startPage(new PdfDocument.PageInfo.Builder(W, H, pageNo).create());
+                      canvas = page.getCanvas();
+                      canvas.drawColor(Color.WHITE);
+                      y = 34;
+                      paint.setStyle(Paint.Style.FILL);
+                      paint.setColor(GREEN_DARK);
+                      canvas.drawRoundRect(new RectF(M, y - 16, W - M, y + 18), 10, 10, paint);
+                      paint.setColor(Color.WHITE);
+                      paint.setTypeface(Typeface.create(Typeface.DEFAULT, Typeface.BOLD));
+                      paint.setTextSize(13);
+                      canvas.drawText("Zgłoś obrączkę", M + 12, y + 6, paint);
+                      paint.setTypeface(Typeface.DEFAULT);
+                      paint.setTextSize(9);
+                      canvas.drawText("strona " + pageNo, W - M - 58, y + 7, paint);
+                      y += 40;
+                  }
+          
+                  void title(String text) {
+                      paint.setColor(GREEN_DARK);
+                      paint.setTypeface(Typeface.create(Typeface.DEFAULT, Typeface.BOLD));
+                      paint.setTextSize(17);
+                      canvas.drawText(text, M, y, paint);
+                      y += 19;
+                      paint.setColor(GREEN);
+                      canvas.drawRoundRect(new RectF(M, y, W - M, y + 3), 2, 2, paint);
+                      y += 9;
+                  }
+          
+                  void subtitle(String text) {
+                      paint.setColor(MUTED);
+                      paint.setTypeface(Typeface.DEFAULT);
+                      paint.setTextSize(8);
+                      for (String line : wrap(text, W - 2 * M, 8)) { canvas.drawText(line, M, y, paint); y += 10; }
+                      y += 2;
+                  }
+          
+                  void section(String text) {
+                      y += 5;
+                      paint.setColor(BLUE);
+                      paint.setTypeface(Typeface.create(Typeface.DEFAULT, Typeface.BOLD));
+                      paint.setTextSize(10);
+                      canvas.drawText(text, M, y, paint);
+                      y += 6;
+                  }
+          
+                  void row(String label, String value) {
+                      if (value == null || value.trim().isEmpty()) value = "—";
+                      List<String> labelLines = wrapLimit(label, 130, 7.0f, 2);
+                      List<String> lines = wrapLimit(value, W - M * 2 - 148, 7.0f, 3);
+                      int rowH = Math.max(16, Math.max(labelLines.size(), lines.size()) * 8 + 6);
+                      if (y + rowH > H - 54) {
+                          // Awaryjne zabezpieczenie: gdy tekst jest bardzo długi, nie wychodzimy poza kartkę.
+                          return;
+                      }
+                      paint.setStyle(Paint.Style.FILL);
+                      paint.setColor(Color.rgb(246, 250, 244));
+                      canvas.drawRect(M, y, M + 140, y + rowH, paint);
+                      paint.setColor(Color.rgb(220, 226, 232));
+                      paint.setStyle(Paint.Style.STROKE);
+                      paint.setStrokeWidth(0.6f);
+                      canvas.drawRect(M, y, W - M, y + rowH, paint);
+                      canvas.drawLine(M + 140, y, M + 140, y + rowH, paint);
+                      paint.setStyle(Paint.Style.FILL);
+                      paint.setColor(TEXT);
+                      paint.setTypeface(Typeface.create(Typeface.DEFAULT, Typeface.BOLD));
+                      paint.setTextSize(7.0f);
+                      int ly = y + 10;
+                      for (String l : labelLines) { canvas.drawText(l, M + 5, ly, paint); ly += 8; }
+                      paint.setTypeface(Typeface.DEFAULT);
+                      int ty = y + 10;
+                      for (String line : lines) { canvas.drawText(line, M + 146, ty, paint); ty += 8; }
+                      y += rowH;
+                  }
+          
+                  void box(String text, int minHeight) {
+                      List<String> lines = wrapLimit(text == null || text.isEmpty() ? "—" : text, W - 2 * M - 16, 8.0f, 5);
+                      int boxH = Math.max(Math.min(minHeight, 44), lines.size() * 10 + 12);
+                      paint.setStyle(Paint.Style.FILL);
+                      paint.setColor(Color.rgb(246, 248, 250));
+                      canvas.drawRoundRect(new RectF(M, y, W - M, y + boxH), 8, 8, paint);
+                      paint.setStyle(Paint.Style.STROKE);
+                      paint.setStrokeWidth(0.8f);
+                      paint.setColor(Color.rgb(210, 216, 222));
+                      canvas.drawRoundRect(new RectF(M, y, W - M, y + boxH), 8, 8, paint);
+                      paint.setStyle(Paint.Style.FILL);
+                      paint.setColor(TEXT);
+                      paint.setTypeface(Typeface.DEFAULT);
+                      paint.setTextSize(8);
+                      int ty = y + 12;
+                      for (String line : lines) { if (ty > y + boxH - 5) break; canvas.drawText(line, M + 8, ty, paint); ty += 10; }
+                      y += boxH + 5;
+                  }
+          
+                  void photoGrid(ArrayList<Uri> uris) {
+                      int count = Math.min(uris.size(), 4);
+                      int gap = 12;
+                      float cellW = (W - 2 * M - gap) / 2f;
+                      float cellH = 285;
+                      for (int i = 0; i < count; i++) {
+                          int col = i % 2;
+                          int row = i / 2;
+                          float left = M + col * (cellW + gap);
+                          float top = y + row * (cellH + 18);
+                          drawPhotoCell(uris.get(i), "Zdjęcie " + (i + 1), left, top, cellW, cellH);
+                      }
+                      y += (count <= 2 ? (int)cellH + 22 : (int)(2 * cellH + 40));
+                  }
+          
+                  void drawPhotoCell(Uri uri, String caption, float left, float top, float cellW, float cellH) {
+                      paint.setStyle(Paint.Style.FILL);
+                      paint.setColor(Color.rgb(246, 248, 250));
+                      canvas.drawRoundRect(new RectF(left, top, left + cellW, top + cellH), 10, 10, paint);
+                      paint.setStyle(Paint.Style.STROKE);
+                      paint.setStrokeWidth(0.8f);
+                      paint.setColor(Color.rgb(210, 216, 222));
+                      canvas.drawRoundRect(new RectF(left, top, left + cellW, top + cellH), 10, 10, paint);
+                      paint.setStyle(Paint.Style.FILL);
+                      paint.setColor(TEXT);
+                      paint.setTypeface(Typeface.create(Typeface.DEFAULT, Typeface.BOLD));
+                      paint.setTextSize(9);
+                      canvas.drawText(caption, left + 8, top + 15, paint);
+                      try {
+                          Bitmap bmp = decodeBitmapFromUri(uri, 1400);
+                          if (bmp == null) return;
+                          float maxW = cellW - 16;
+                          float maxH = cellH - 34;
+                          float scale = Math.min(maxW / bmp.getWidth(), maxH / bmp.getHeight());
+                          float dw = bmp.getWidth() * scale;
+                          float dh = bmp.getHeight() * scale;
+                          RectF dst = new RectF(left + 8 + (maxW - dw) / 2f, top + 24, left + 8 + (maxW - dw) / 2f + dw, top + 24 + dh);
+                          canvas.drawBitmap(bmp, null, dst, null);
+                          bmp.recycle();
+                      } catch (Exception ignored) {}
+                  }
+          
+                  void footer(String text) {
+                      paint.setColor(MUTED);
+                      paint.setTypeface(Typeface.DEFAULT);
+                      paint.setTextSize(8.5f);
+                      for (String line : wrap(text, W - 2 * M, 8.5f)) { canvas.drawText(line, M, H - 34, paint); break; }
+                  }
+          
+                  List<String> wrap(String text, float maxWidth, float size) {
+                      paint.setTextSize(size);
+                      ArrayList<String> result = new ArrayList<>();
+                      if (text == null) text = "";
+                      text = text.replace('\n', ' ');
+                      String[] words = text.split("\\s+");
+                      StringBuilder line = new StringBuilder();
+                      for (String word : words) {
+                          String test = line.length() == 0 ? word : line + " " + word;
+                          if (paint.measureText(test) <= maxWidth || line.length() == 0) { line.setLength(0); line.append(test); }
+                          else { result.add(line.toString()); line.setLength(0); line.append(word); }
+                      }
+                      if (line.length() > 0) result.add(line.toString());
+                      if (result.isEmpty()) result.add("—");
+                      return result;
+                  }
+          
+
+                  List<String> wrapLimit(String text, float maxWidth, float size, int maxLines) {
+                      List<String> all = wrap(text, maxWidth, size);
+                      if (all.size() <= maxLines) return all;
+                      ArrayList<String> limited = new ArrayList<>();
+                      for (int i = 0; i < maxLines; i++) limited.add(all.get(i));
+                      String last = limited.get(maxLines - 1);
+                      while (last.length() > 1 && paint.measureText(last + "…") > maxWidth) last = last.substring(0, last.length() - 1);
+                      limited.set(maxLines - 1, last + "…");
+                      return limited;
+                  }
+          
+                  void finish(File file) throws IOException {
+                      if (page != null) document.finishPage(page);
+                      FileOutputStream out = new FileOutputStream(file);
+                      try { document.writeTo(out); }
+                      finally { out.close(); document.close(); }
+                  }
+              }
+          
+              private ArrayList<DocImage> prepareDocImages() {
+                  ArrayList<DocImage> result = new ArrayList<>();
+                  int index = 1;
+                  for (Uri uri : photoUris) {
+                      try {
+                          Bitmap bmp = decodeBitmapFromUri(uri, 1600);
+                          if (bmp == null) continue;
+                          ByteArrayOutputStream out = new ByteArrayOutputStream();
+                          bmp.compress(Bitmap.CompressFormat.JPEG, 86, out);
+                          DocImage img = new DocImage();
+                          img.name = "image" + index + ".jpg";
+                          img.relId = "rIdImg" + index;
+                          img.caption = "Zdjęcie " + index;
+                          img.bytes = out.toByteArray();
+                          img.width = bmp.getWidth();
+                          img.height = bmp.getHeight();
+                          result.add(img);
+                          bmp.recycle();
+                          index++;
+                      } catch (Exception ignored) {}
+                  }
+                  return result;
+              }
+          
+              private Bitmap decodeBitmapFromUri(Uri uri, int maxDim) throws IOException {
+                  InputStream in1 = getContentResolver().openInputStream(uri);
+                  if (in1 == null) return null;
+                  BitmapFactory.Options bounds = new BitmapFactory.Options();
+                  bounds.inJustDecodeBounds = true;
+                  try { BitmapFactory.decodeStream(in1, null, bounds); } finally { in1.close(); }
+                  int sample = 1;
+                  while (bounds.outWidth / sample > maxDim || bounds.outHeight / sample > maxDim) sample *= 2;
+                  BitmapFactory.Options opts = new BitmapFactory.Options();
+                  opts.inSampleSize = Math.max(1, sample);
+                  InputStream in2 = getContentResolver().openInputStream(uri);
+                  if (in2 == null) return null;
+                  Bitmap bmp;
+                  try { bmp = BitmapFactory.decodeStream(in2, null, opts); } finally { in2.close(); }
+                  if (bmp == null) return null;
+                  int max = Math.max(bmp.getWidth(), bmp.getHeight());
+                  if (max <= maxDim) return bmp;
+                  float scale = maxDim / (float) max;
+                  Bitmap scaled = Bitmap.createScaledBitmap(bmp, Math.round(bmp.getWidth() * scale), Math.round(bmp.getHeight() * scale), true);
+                  bmp.recycle();
+                  return scaled;
+              }
