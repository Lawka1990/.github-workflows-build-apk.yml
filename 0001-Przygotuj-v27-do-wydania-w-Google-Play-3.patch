+          name: ZglosObraczke-v27-APK-testowy
+          path: app/build/outputs/apk/debug/*.apk
+          if-no-files-found: error
+          retention-days: 30
+
+      - name: Przygotuj bezpieczny podpis wydawniczy
+        shell: bash
+        env:
+          ANDROID_KEYSTORE_BASE64: ${{ secrets.ANDROID_KEYSTORE_BASE64 }}
+          ANDROID_KEYSTORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
+          ANDROID_KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
+          ANDROID_KEY_PASSWORD: ${{ secrets.ANDROID_KEY_PASSWORD }}
+        run: |
+          set -euo pipefail
+
+          missing=()
+          for variable in ANDROID_KEYSTORE_BASE64 ANDROID_KEYSTORE_PASSWORD ANDROID_KEY_ALIAS ANDROID_KEY_PASSWORD; do
+            if [ -z "${!variable:-}" ]; then
+              missing+=("$variable")
+            fi
+          done
+
+          if [ "${#missing[@]}" -gt 0 ]; then
+            echo "::error::Brakuje GitHub Secrets: ${missing[*]}"
+            echo "AAB nie zostanie podpisany losowym kluczem. Dodaj stały klucz wydawniczy i uruchom workflow ponownie."
+            exit 1
+          fi
+
+          printf '%s' "$ANDROID_KEYSTORE_BASE64" | base64 --decode > upload-keystore.jks
+          keytool -list \
+            -keystore upload-keystore.jks \
+            -storepass "$ANDROID_KEYSTORE_PASSWORD" \
+            -alias "$ANDROID_KEY_ALIAS" >/dev/null
+
+          cat > signing.gradle <<'EOF_SIGNING'
+          android {
+              signingConfigs {
+                  release {
+                      storeFile rootProject.file('upload-keystore.jks')
+                      storePassword System.getenv('ANDROID_KEYSTORE_PASSWORD')
+                      keyAlias System.getenv('ANDROID_KEY_ALIAS')
+                      keyPassword System.getenv('ANDROID_KEY_PASSWORD')
+                  }
+              }
+              buildTypes {
+                  release {
+                      signingConfig signingConfigs.release
+                  }
+              }
+          }
+          EOF_SIGNING
+
+          echo "apply from: rootProject.file('signing.gradle')" >> app/build.gradle
+
+      - name: Zbuduj podpisany AAB dla Google Play
+        shell: bash
+        env:
+          ANDROID_KEYSTORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
+          ANDROID_KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
+          ANDROID_KEY_PASSWORD: ${{ secrets.ANDROID_KEY_PASSWORD }}
+        run: gradle :app:bundleRelease --no-daemon --stacktrace
+
+      - name: Sprawdź i przygotuj AAB
+        shell: bash
+        run: |
+          set -euo pipefail
+
+          AAB_FILE="$(find app/build/outputs/bundle/release -name '*.aab' -print -quit)"
+          if [ -z "$AAB_FILE" ]; then
+            echo "::error::Nie znaleziono wynikowego pliku AAB."
+            exit 1
+          fi
+
+          mkdir -p release
+          cp "$AAB_FILE" "release/ZglosObraczke-v27-${GITHUB_RUN_NUMBER}.aab"
+          jarsigner -verify "release/ZglosObraczke-v27-${GITHUB_RUN_NUMBER}.aab"
+          sha256sum "release/ZglosObraczke-v27-${GITHUB_RUN_NUMBER}.aab" > "release/ZglosObraczke-v27-${GITHUB_RUN_NUMBER}.aab.sha256"
+
+          echo "Pakiet: pl.bartoszlawicki.zglosobraczke"
+          echo "versionCode: $((1000000 + GITHUB_RUN_NUMBER))"
+          ls -lh release
+
+      - name: Zapisz podpisany AAB dla Google Play
+        uses: actions/upload-artifact@v4
+        with:
+          name: ZglosObraczke-v27-Google-Play
+          path: release/*
+          if-no-files-found: error
+          retention-days: 90
